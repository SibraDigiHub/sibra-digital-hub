# Sibra Digital Hub — backend environment. PostgreSQL is the only database engine.
# Copy to .env and fill real values. Never commit real secrets.

# ── Database (required) ─────────────────────────────
# Pooled connection — used by the application at runtime (Neon pgbouncer).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Direct connection — used by prisma migrate (bypasses pgbouncer).
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# ── Admin auth (T4) — REQUIRED. Generate real values, never commit them ──
# openssl rand -base64 32  → AES-256-GCM key encrypting TOTP secrets at rest.
ENCRYPTION_KEY=""
# openssl rand -base64 32  → ≥32 bytes; salt for IP/UA/recovery-code hashes.
SESSION_PEPPER=""
# Second factor mandatory (defaults to true in production; dev may disable).
ADMIN_REQUIRE_2FA="true"
# WebAuthn passkeys on/off.
ADMIN_PASSKEYS_ENABLED="true"
# RP ID = bare host the browser sees (frontend origin); no scheme/port.
ADMIN_WEBAUTHN_RP_ID=""
ADMIN_WEBAUTHN_RP_NAME="Sibra Digital Hub"
# Full origin that must match the browser's, e.g. https://your-site.com
ADMIN_WEBAUTHN_ORIGIN=""
# Reset-token lifetime in minutes.
ADMIN_RESET_TTL_MINUTES="30"
# Used to build password-reset links (NEVER the request Host header).
# Production value: the frontend deployment URL, e.g. https://your-site.com
PUBLIC_WEB_URL=""
# Shared secret the frontend proxy adds as `x-internal-key` — enforced by
# backend/src/proxy.ts on every /api/* call (T4-b §5.14). Must EXACTLY
# match the frontend deployment's INTERNAL_API_KEY.
INTERNAL_API_KEY=""
# Optional: previous key, still accepted while rotating the shared secret.
INTERNAL_API_KEY_PREVIOUS=""
# Optional: cron endpoint bearer token. REQUIRED in production (boot guard):
# /api/cron/reconcile-payments + /api/cron/retry-emails check
# `Authorization: Bearer $CRON_SECRET` and fulfil payments whose webhook
# was lost + retry failed delivery emails (see docs/DEPLOYMENT.md).
CRON_SECRET=""
# P1: legacy POST /api/orders is retired (410 Gone) — in production ALWAYS,
# and in dev unless this is explicitly true. Leave empty.
LEGACY_ORDERS_ENABLED=""
# P2 warning flag: allows localhost/127.0.0.1 backend URLs. Reserved escape
# hatch for throwaway sandboxes only — production prints a loud boot warning
# when it is set, and GET /api shows it via { demoMode, testPaymentsAllowed }.
ALLOW_LOCAL_BACKEND_URL=""

# ── Not applicable (master-prompt §10.4 names that this codebase does not use) ──
# SETUP_TOKEN — there is no first-admin setup wizard. Create the first admin
#   (and any additional admins) with the break-glass CLI instead:
#     cd backend && DATABASE_URL=… DIRECT_URL=… bun run admin:create
#   (see docs/ADMIN_RECOVERY.md + docs/DEPLOYMENT.md).
# LEGAL_* — legal-page contact values are NOT env-driven: they live in the
#   site Settings row (admin console → DB, served by /api/settings) and in
#   frontend/src/components/LegalView.tsx.
# SUPABASE_* — not used; the database is PostgreSQL on Neon (DATABASE_URL/DIRECT_URL).

# ── Demo / staging escape hatch (T7 §8.1) ──────────────
# Production REFUSES to boot with mock/console providers: demo Razorpay
# (keys missing), the console email driver (explicit, or RESEND_API_KEY
# missing), a missing/weak INTERNAL_API_KEY, or any EMAIL_API_URL override
# (never allowed, even with DEMO_MODE). Staging/demo deployments that
# accept those states set DEMO_MODE=true explicitly. NEVER set on a real
# store — it re-enables simulated payments and demo-logged email.
DEMO_MODE=""

# ── Razorpay (single gateway — India + International) ──
# ONE gateway for every customer: India → Razorpay Order in INR
# (Standard Checkout), international → Razorpay Order in the configured
# foreign currency (below). Without KEY_ID/KEY_SECRET the app runs in
# demo mode (payments simulated, demo-pay route available in
# non-production only). Where to obtain: Razorpay Dashboard → Settings →
# API Keys → Generate Test/Live Key. See docs/RAZORPAY_SETUP.md.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Must agree with the key prefix: test ⇒ rzp_test_…, live ⇒ rzp_live_…
# (production refuses to boot on mismatch; dev logs a warning).
RAZORPAY_MODE=""
# HMAC secret verifying X-Razorpay-Signature on webhook deliveries.
# Required in production whenever the keys are set — webhooks drive
# fulfilment. Configure the webhook URL + events in the Dashboard:
# https://<backend>/api/razorpay/webhook (see docs/RAZORPAY_SETUP.md).
RAZORPAY_WEBHOOK_SECRET=""
# International checkout gate: false (default) → non-India buyers see the
# friendly marketplace fallback. Set true ONLY after Razorpay confirms
# International Payments activation for the account.
INTERNATIONAL_CHECKOUT_ENABLED="false"
# Comma list of foreign currencies enabled for this merchant (default USD).
# Prices are admin-set per product (priceUsd today) — never conversions.
RAZORPAY_FOREIGN_CURRENCIES="USD"
# Comma-separated ISO country codes refused for direct checkout
# (default empty). The retired PAYPAL_BLOCKED_COUNTRIES variable is still
# honoured as a legacy alias.
RAZORPAY_BLOCKED_COUNTRIES=""
# TEST-ONLY: overrides the Razorpay API base (local mock server in tests).
# NEVER set in a real deployment (production refuses to boot).
RAZORPAY_API_BASE=""
# Download-link lifetime in hours (default 48) and per-order download cap
# (default 5) minted at fulfillment.
DOWNLOAD_TTL_HOURS="48"
DOWNLOAD_MAX_DEFAULT="5"

# ── Email (T6) ─────────────────────────────────────────
# Driver selection: "resend" (real sends) or "console" (dev: emails are
# logged with a MASKED recipient + subject, never sent). When unset, the
# driver is resend iff RESEND_API_KEY is set, else console — a missing key
# NEVER crashes: it falls back to the console driver with a warning.
EMAIL_PROVIDER=""
# Resend API key (server-only, never logged, never exposed to the client).
RESEND_API_KEY=""
# Sender address. ONLY used by the resend driver. Must live on a domain
# VERIFIED in Resend — without a verified domain Resend delivers test mail
# to the account owner's address ONLY, so real customers would receive
# nothing. That is why the download link ALSO lives on the thank-you page
# and the admin "resend email" action: email is never the only delivery
# path for a paid file.
EMAIL_FROM=""
# INTERNAL — tests only: overrides the Resend API endpoint (mock server).
# Never set this in a real deployment.
EMAIL_API_URL=""

# ── ImageKit (T6) ──────────────────────────────────────
# Without these three values the upload-signing route answers 501
# { fallback: true } (admin form falls back) and ik: deliverable
# references answer 404 — everything degrades gracefully in dev.
# Server-side private key (NEVER exposed; signs upload params + private
# file download URLs — signing happens only in src/lib/storage.ts).
IMAGEKIT_PRIVATE_KEY=""
# Public key + URL endpoint — safe for the browser (NEXT_PUBLIC_ prefix):
# the admin upload form uses them for direct browser uploads. The signing
# route GET /api/imagekit/auth (admin session required) returns them.
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=""
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=""
# Upload allow-lists + caps (enforced by src/lib/storage.ts, documented
# for the admin form): public media jpg/png/webp/gif + video mp4/webm
# (SVG refused) capped at 25 MB; deliverables pdf/zip/apk/epub/txt
# capped at 100 MB. Deliverables can also be an external https URL, or
# an ImageKit private file stored as `ik:<path>` in Product.deliverableUrl
# (10-minute signed download URLs are minted server-side at claim time).

# ── Dual-payment behaviour (§2.3/§6.7/§10.6) ──────────
# Allow a customer who already owns the product to buy it again (default false —
# the create endpoint answers with the "resend my link" message instead).
ALLOW_REPEAT_PURCHASE="false"
# Refunds/disputes revoke download access (default true).
REVOKE_ON_REFUND="true"
# Refuse foreign-card payments on India-billed orders.
# RECOMMENDED: "true" — INR payment links are for Indian buyers; a captured
# foreign card on an IN order is refused (409), the order is flagged
# INTERNATIONAL_CARD_BLOCKED, and the buyer sees a friendly retry/marketplace
# message in the checkout dialog. With "false" the payment IS fulfilled and
# only flagged INTERNATIONAL_CARD_ON_IN_ORDER + an admin alert (legacy risk
# acceptance — do not change behavior expectations when false).
RAZORPAY_BLOCK_INTERNATIONAL_CARDS="true"
# §10.6 explicit staging override: allows sandbox/test gateways (and their
# fulfilment) in production. NEVER set on a real store — sandbox payments
# must never deliver real files.
ALLOW_TEST_PAYMENTS_IN_PRODUCTION="false"
# Alert recipient for payment security alerts (default: first admin's email).
PAYMENT_ALERT_EMAIL=""
# Per-gateway kill switch (default on when unset). Razorpay is the ONLY
# gateway; PayPal has no switch any more (the independent integration is
# removed — PayPal appears only inside Razorpay Checkout when the owner
# links it in the Razorpay Dashboard).
RAZORPAY_ENABLED="true"

# Note on NEXT_PUBLIC_RAZORPAY_KEY_ID (§11): this project's frontend is a
# SEPARATE deployment that talks to the backend through the x-internal-key
# proxy — the public key id is served by GET /api/payments/config and the
# checkout options by POST /api/checkout/create, so no secret or id is ever
# baked into the frontend bundle.
