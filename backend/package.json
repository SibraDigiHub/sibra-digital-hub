{
  "name": "sibra-digital-hub-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001 2>&1 | tee ../backend-dev.log",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:contract",
    "test:contract": "bash tests/contract/run-fixture.sh replay",
    "test:contract:capture": "bash tests/contract/run-fixture.sh capture",
    "test:contract:live": "bun tests/contract/runner.ts replay",
    "check:leaks": "bun scripts/check-leaks.ts",
    "verify:t5": "ALLOW_DESTRUCTIVE_TESTS=true bun scripts/t5-verify.ts",
    "verify:t6": "ALLOW_DESTRUCTIVE_TESTS=true bun scripts/t6-verify.ts",
    "verify:t7": "bun scripts/t7-verify.ts",
    "test:security": "ALLOW_DESTRUCTIVE_TESTS=true bun test tests/security/",
    "test:perf": "bun test tests/perf/",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "bun prisma/seed.ts",
    "dev-db": "bash scripts/dev-db.sh",
    "gen:sample-pdf": "bun scripts/gen-sample-pdf.ts",
    "update:deliverables": "bun scripts/update-deliverables.ts",
    "admin:create": "bun scripts/admin-create.ts",
    "admin:reset-password": "bun scripts/admin-reset-password.ts",
    "admin:reset-2fa": "bun scripts/admin-reset-2fa.ts",
    "test:payments": "ALLOW_DESTRUCTIVE_TESTS=true bun test tests/payments/",
    "test:routes": "bun test tests/routes/",
    "payments:smoke": "bun scripts/payments-smoke.ts"
  },
  "prisma": {
    "seed": "bun prisma/seed.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.11.1",
    "@simplewebauthn/server": "^14.0.3",
    "jose": "^6.2.12",
    "next": "^16.1.1",
    "otplib": "^13.5.0",
    "pdf-lib": "^1.17.1",
    "pg": "8.16.3",
    "pino": "9.7.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "prisma": "^6.11.1",
    "typescript": "^5"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}