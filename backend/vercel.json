{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma generate && prisma migrate deploy && next build",
  "regions": [
    "bom1"
  ],
  "functions": {
    "src/app/api/**/route.ts": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/cron/reconcile-payments",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/retry-emails",
      "schedule": "*/10 * * * *"
    }
  ]
}
