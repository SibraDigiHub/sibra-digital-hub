# Sibra Digital Hub — frontend environment example.
# Copy to .env and fill real values. Never commit real secrets.

# ── Backend proxy target (server-side) ──────────────
# The rewrite target for /api/* (next.config.ts). On Vercel set this to
# the backend deployment URL (https://<backend>.vercel.app).
BACKEND_URL="https://your-backend.example.com"
# T9 alias: API_INTERNAL_URL (the master-prompt §10.2 name) is accepted as
# a fallback when BACKEND_URL is not set — BACKEND_URL wins when both are
# set. Deployers only need ONE of the two; BACKEND_URL is what the code
# and docs use.
# API_INTERNAL_URL="https://your-backend.example.com"

# ── Shared transport secret (server-side, NEVER NEXT_PUBLIC_) ──
# The frontend proxy (src/proxy.ts) adds this as `x-internal-key` before
# rewriting /api/* to the backend, whose guard refuses calls without it.
# MUST match the backend deployment's INTERNAL_API_KEY exactly (rotate
# together; see docs/OWNER_CHECKLIST.md).
# REQUIRED in production — src/config/env.ts refuses to serve /api without it.
INTERNAL_API_KEY=""

# ── Public site origin (safe for the browser) ───────
# Consumed by the T8 metadata/sitemap/OG work to build absolute URLs,
# e.g. https://your-site.com (localhost:3000 fallback is dev-only).
NEXT_PUBLIC_SITE_URL=""

# ── Gateway "Admin" button (safe for the browser) ───
# Visibility of the public Admin button on the gateway (Switch World) screen:
# dev shows it, production HIDES it by default. Set to "true" to show the
# button in production too. This is a UI convenience only — the console
# itself always remains reachable via #/admin and stays fully auth-gated.
# NEXT_PUBLIC_SHOW_ADMIN="true"

# ── Not applicable (master-prompt §10.4 names this codebase does not read) ──
# NEXT_PUBLIC_RAZORPAY_KEY_ID — not read by the frontend: checkout opens a
#   payment LINK created by the backend (no Razorpay checkout.js bundle).
#   Only add it if you later integrate checkout.js on the client.
# NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT — not read from env by the frontend:
#   the admin upload form receives publicKey/urlEndpoint/signature from the
#   backend signing route (GET /api/imagekit/auth), which reads the server
#   IMAGEKIT_* vars. Set those on the BACKEND, not here.
# NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY — same as above (backend route provides it).
# REVALIDATE_SECRET — not used anywhere in this codebase; nothing to set.

# ── Legal pages (About / Pricing / Privacy / Terms / Refund / Contact) ──
# All OPTIONAL. Unset values are simply omitted from the pages —
# never faked. See docs/LEGAL_PAGES.md for how each is used.
# NOTE: the owner / grievance-officer NAME now has a committed default
# ("Azaz Mohammad" — LEGAL_OWNER_NAME in src/lib/legal/shared.ts); these
# env vars still override that default when set.
# The support e-mail does NOT live here: it is the admin-editable
# "contactEmail" served by GET /api/settings (SiteSetting).
# NEXT_PUBLIC_LEGAL_OWNER_NAME=""            # overrides the committed owner name
# NEXT_PUBLIC_BUSINESS_ADDRESS=""            # overrides the committed postal address (BUSINESS_ADDRESS in shared.ts)
# NEXT_PUBLIC_SUPPORT_PHONE=""               # phone / WhatsApp line (contact)
# NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=""      # overrides the committed officer name
# NEXT_PUBLIC_LEGAL_JURISDICTION=""          # overrides the committed jurisdiction (LEGAL_JURISDICTION in shared.ts)
# NEXT_PUBLIC_PRIVACY_RESPONSE_TIME_TEXT=""  # overrides the default response-time promise
